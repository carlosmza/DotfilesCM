layout {
    tab focus=true {
        pane
    }
    // tab name="Opencode" {
    //     pane
    // }
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="file:/home/carlosm/.config/zellij/plugins/zjstatus.wasm" {

                // Style mode
                mode_normal        "#[fg=#458588,bold] NORMAL "
                mode_locked        "#[fg=#cc241d,bold] LOCKED "
                mode_pane          "#[fg=#98971a,bold] PANE "
                mode_tab        "#[fg=#689d6a,bold] TAB "
                mode_scroll        "#[fg=#d65d0e,bold] SCROLL "
                mode_enter_search          "#[fg=#d79921,bold] ENT_SEARCH "
                mode_search        "#[fg=#b16286,bold] SEARCH "
                mode_resize        "#[fg=#cc241d,bold] RESIZE "
                mode_rename_tab          "#[fg=#9d0006,bold] REN_TAB "
                mode_move        "#[fg=#d65d0e,bold] MOVE "
                mode_rename_pane          "#[fg=#9d0006,bold] REN_PANE "
                mode_session        "#[fg=#689d6a,bold] SESSION "
                mode_prompt          "#[fg=#d79921,bold] PROMPT "

                // Notifications
                notification_format_unread           "#[fg=#458588,bg=#fbf1c7,blink]  #[fg=#89B4FA,bg=#181825] {message} "
                notification_format_no_notifications "#[fg=#458588,bg=#fbf1c7,dim]   "
                notification_show_interval           "10"

                // Format
                format_left   "#[] {session} {mode}"
                format_center  "{tabs}"
                format_right  " {command_git_branch}"
                format_space  "+"

                border_enabled  "false"
                border_char     "─"
                border_format   "#[fg=#bdae93]{char}"
                border_position "top"

                hide_frame_for_single_pane "false"


                // Tabs
                tab_normal   "#[fg=#7c6f64] {name} "
                tab_active   "#[fg=#fbf1c7,bg=#458588,bold,italic] {name} "
                tab_separator   "#[fg=#bdae93] | "
                tab_rename   "#[fg=#cc241d,bg=#fbf1c7] {index} {name} {floating_indicator} "

                command_git_branch_command     "git rev-parse --abbrev-ref HEAD"
                command_git_branch_format      "#[fg=#458588] {stdout} "
                command_git_branch_interval    "10"
                command_git_branch_rendermode  "static"

                // indicators
                tab_sync_indicator       "<> "
                tab_fullscreen_indicator "[] "
                tab_floating_indicator   "o"
              }
          }
      }
}
