#!/usr/bin/env python3 # -*- coding: utf-8 -*- """ Parser para la salida de: sdcv -n -u "Collins Cobuild 5" palabra | html2text [opciones] Convierte el texto estructurado en una salida legible, lista para mostrar como definición o traducción. """ import sys import re def parse_sdcv_output(texto_bruto): """ Analiza el texto de entrada y devuelve una lista de diccionarios, cada uno representando una entrada del diccionario. """ entradas = [] # Separador entre entradas: "* * *" (puede tener espacios y saltos de línea) bloques = re.split(r'\n?\\* \\* \\*\n?', texto_bruto.strip()) for bloque in bloques: if not bloque.strip(): continue lineas = bloque.splitlines() # Buscar la línea que inicia una entrada (-->Collins Cobuild 5 -->) inicio = None for i, linea in enumerate(lineas): if linea.startswith('-->Collins Cobuild 5 -->'): inicio = i break if inicio is None: continue # Extraer la línea del encabezado (palabra + posible pronunciación) linea_encabezado = lineas[inicio].replace('-->Collins Cobuild 5 -->', '').strip() # Separar pronunciación si existe (entre /.../) pronunciacion = None palabra_texto = linea_encabezado match_slash = re.search(r'(/.+/)', linea_encabezado) if match_slash: pronunciacion = match_slash.group(1) palabra_texto = linea_encabezado[:match_slash.start()].strip() # Líneas restantes después del encabezado resto_lineas = lineas[inicio+1:] # Variables para la entrada actual categoria = None definicion_lineas = [] ejemplos = [] ver_tambien = None seccion_actual = 'definicion' # puede ser 'definicion' después de la categoría for linea in resto_lineas: linea_limpia = linea.strip() if not linea_limpia: continue # Categoría gramatical: suele estar entre corchetes if linea_limpia.startswith('[') and ']' in linea_limpia: categoria = linea_limpia seccion_actual = 'definicion' continue # Ejemplo con viñeta ● if linea_limpia.startswith('●'): ejemplos.append(linea_limpia.lstrip('●').strip()) continue # Referencia "see also" if linea_limpia.lower().startswith('see also'): ver_tambien = linea_limpia[len('see also'):].strip() continue # Todo lo demás se considera parte de la definición if seccion_actual == 'definicion': definicion_lineas.append(linea_limpia) # Unir las líneas de la definición (se reemplazan saltos de línea por espacio) definicion = ' '.join(definicion_lineas).strip() entradas.append({ 'palabra': palabra_texto, 'pronunciacion': pronunciacion, 'categoria': categoria, 'definicion': definicion, 'ejemplos': ejemplos, 'ver_tambien': ver_tambien }) return entradas def mostrar_entradas(entradas): """Imprime cada entrada en un formato limpio y legible.""" for entrada in entradas: print(f"Palabra: {entrada['palabra']}") if entrada['pronunciacion']: print(f"Pronunciación: {entrada['pronunciacion']}") if entrada['categoria']: print(f"Tipo: {entrada['categoria']}") if entrada['definicion']: print(f"Definición: {entrada['definicion']}") for ej in entrada['ejemplos']: print(f"Ejemplo: {ej}") if entrada['ver_tambien']: print(f"Ver también: {entrada['ver_tambien']}") print() # línea en blanco entre entradas def main(): texto = sys.stdin.read() if not texto: print("Error: No hay datos en la entrada estándar.", file=sys.stderr) sys.exit(1) entradas = parse_sdcv_output(texto) if not entradas: print("No se encontraron entradas válidas.", file=sys.stderr) sys.exit(1) mostrar_entradas(entradas) if __name__ == '__main__': main() 
